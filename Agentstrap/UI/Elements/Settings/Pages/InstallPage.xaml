<ui:UiPage x:Class="Agentstrap.UI.Elements.Settings.Pages.InstallPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Agentstrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:Agentstrap.Resources"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <TextBlock Style="{StaticResource AgPageTitle}" Text="Install" />
        <TextBlock Style="{StaticResource AgPageSubtitle}"
                   Text="Install, repair or reinstall Roblox and Roblox Studio through Agentstrap." />

        <Border Margin="0,10,0,0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AgCard}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding InstallStatus}" />
                <ProgressBar IsIndeterminate="True" Height="6" Margin="0,10,0,0" />
                <TextBlock Margin="0,8,0,0" FontSize="12" Text="Please keep this window open while the installation runs."
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Roblox Player -->
        <TextBlock Style="{StaticResource AgSectionHeader}" Text="Roblox Player" />

        <controls:OptionControl Header="Status"
                                Description="{Binding RobloxDetails}">
            <TextBlock Text="{Binding RobloxStatus}" FontWeight="SemiBold" />
        </controls:OptionControl>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource AgCardGap}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:Button Appearance="Secondary" Grid.Column="0" Style="{StaticResource AgActionButton}"
                       Icon="Play24" Content="Install / Repair"
                       Command="{Binding InstallRobloxCommand, Mode=OneTime}" />

            <ui:Button Appearance="Secondary" Grid.Column="2" Style="{StaticResource AgActionButton}"
                       Icon="ArrowSync24" Content="Reinstall"
                       Command="{Binding ReinstallRobloxCommand, Mode=OneTime}" />
        </Grid>

        <!-- Roblox Studio -->
        <TextBlock Style="{StaticResource AgSectionHeader}" Text="Roblox Studio" Margin="0,24,0,0" />

        <controls:OptionControl Header="Status"
                                Description="{Binding StudioDetails}">
            <TextBlock Text="{Binding StudioStatus}" FontWeight="SemiBold" />
        </controls:OptionControl>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource AgCardGap}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:Button Appearance="Secondary" Grid.Column="0" Style="{StaticResource AgActionButton}"
                       Icon="Play24" Content="Install / Repair"
                       Command="{Binding InstallStudioCommand, Mode=OneTime}" />

            <ui:Button Appearance="Secondary" Grid.Column="2" Style="{StaticResource AgActionButton}"
                       Icon="ArrowSync24" Content="Reinstall"
                       Command="{Binding ReinstallStudioCommand, Mode=OneTime}" />
        </Grid>
    </StackPanel>
</ui:UiPage>
