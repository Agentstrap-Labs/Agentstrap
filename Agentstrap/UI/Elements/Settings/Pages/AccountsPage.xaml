<ui:UiPage x:Class="Agentstrap.UI.Elements.Settings.Pages.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:Agentstrap.Resources"
      Scrollable="True">
    <StackPanel Margin="22,20,22,24">
        <Image x:Name="AvatarImage" Width="64" Height="64" Margin="0,0,0,12" />
        <TextBlock Text="Accounts" Style="{StaticResource AgPageTitle}" />
        <TextBlock Text="Saved Roblox accounts. Only one account is active at a time." Style="{StaticResource AgBody}" Margin="0,0,0,12" />

        <ListBox x:Name="AccountList" Height="160" Margin="0,0,0,12" />

        <TextBox x:Name="QuickCodeBox" Height="32" IsReadOnly="True" Margin="0,8,0,0" />
        <ui:Button Content="Copy code" Click="CopyCode_Click" Style="{StaticResource AgActionButton}" Width="120" Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <ui:Button Content="Quick Sign In" Click="QuickSign_Click" Style="{StaticResource AgActionButton}" Width="160" />
            <ui:Button Content="Logout" Click="Logout_Click" Style="{StaticResource AgActionButton}" Width="120" Margin="8,0,0,0" />
            <ui:Button Content="Switch to selected" Click="Switch_Click" Style="{StaticResource AgActionButton}" Width="160" Margin="8,0,0,0" />
            <ui:Button Content="Remove selected" Click="Remove_Click" Appearance="Danger" Style="{StaticResource AgActionButton}" Width="160" Margin="8,0,0,0" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Style="{StaticResource AgBody}" Margin="0,12,0,0" />
    </StackPanel>
</ui:UiPage>
