<ui:UiPage x:Class="Agentstrap.UI.Elements.Settings.Pages.IntegrationsPage"
      x:Name="IntegrationsPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:models="clr-namespace:Agentstrap.UI.ViewModels"
      xmlns:controls="clr-namespace:Agentstrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:Agentstrap.Resources"
      mc:Ignorable="d"
      d:DesignHeight="1080" d:DesignWidth="800"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Style="{StaticResource AgPageTitle}" Text="{x:Static resources:Strings.Menu_Integrations_Title}" />
        <TextBlock Style="{StaticResource AgPageSubtitle}" Text="{x:Static resources:Strings.Menu_Integrations_Description}" />

        <TextBlock Style="{StaticResource AgSectionHeader}" Text="{x:Static resources:Strings.Menu_Integrations_ActivityTracking}" />

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_Integrations_EnableActivityTracking_Title}" 
            Description="{x:Static resources:Strings.Menu_Integrations_EnableActivityTracking_Description}" 
            HelpLink="https://agentstrap-doc.pages.dev/features/activity-tracking.html"
            x:Name="ActivityTrackingOption">
            <ui:ToggleSwitch IsChecked="{Binding ActivityTrackingEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_Integrations_QueryServerLocation_Title}" 
            Description="{Binding Source={x:Static resources:Strings.Menu_Integrations_QueryServerLocation_Description}, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://ipinfo.io'}"
            HelpLink="https://agentstrap-doc.pages.dev/features/server-location-hints.html"
            IsEnabled="{Binding InnerContent.IsChecked, ElementName=ActivityTrackingOption, Mode=OneWay}">
            <ui:ToggleSwitch IsChecked="{Binding ShowServerDetailsEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_Integrations_ServerConnectionOverlay_Title}" 
            Description="{Binding Source={x:Static resources:Strings.Menu_Integrations_ServerConnectionOverlay_Description}, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://ipinfo.io'}"
            IsEnabled="{Binding InnerContent.IsChecked, ElementName=ActivityTrackingOption, Mode=OneWay}"
            x:Name="ServerConnectionOverlayOption">
            <ui:ToggleSwitch IsChecked="{Binding ServerConnectionOverlayEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_Integrations_ServerConnectionOverlayDuration_Title}" 
            Description="{x:Static resources:Strings.Menu_Integrations_ServerConnectionOverlayDuration_Description}">
            <!--
                The row itself stays enabled so that the test button is always clickable,
                even while the notification is turned off (which is exactly when a preview
                is most useful). Only the duration box follows the toggle.
            -->
            <StackPanel Orientation="Horizontal">
                <ui:NumberBox Value="{Binding ServerConnectionOverlayDuration, Mode=TwoWay}" Min="1" Max="30" Step="1" IntegersOnly="True" SpinButtonsEnabled="True" Width="120"
                              IsEnabled="{Binding ServerConnectionOverlayEnabled, Mode=OneWay}" />
                <ui:Button Margin="8,0,0,0"
                           Icon="Play24"
                           Content="{x:Static resources:Strings.Menu_Integrations_ServerConnectionOverlay_Test}"
                           Click="PreviewOverlay_Click" />
            </StackPanel>
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_Integrations_DesktopApp_Title}" 
            Description="{Binding Source={x:Static resources:Strings.Menu_Integrations_DesktopApp_Description}, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://agentstrap-doc.pages.dev/features/dont-exit-to-desktop-app.html'}"
            HelpLink="https://agentstrap-doc.pages.dev/features/dont-exit-to-desktop-app.html"
            IsEnabled="{Binding InnerContent.IsChecked, ElementName=ActivityTrackingOption, Mode=OneWay}">
            <ui:ToggleSwitch IsChecked="{Binding DisableAppPatchEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Style="{StaticResource AgSectionHeader}" Text="{x:Static resources:Strings.Common_DiscordRichPresence}" />
        <controls:MarkdownTextBlock Style="{StaticResource AgBody}" MarkdownText="{Binding Source={x:Static resources:Strings.Menu_Integrations_RequiresActivityTracking}, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://agentstrap-doc.pages.dev/features/discord-rich-presence.html'}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_Integrations_ShowGameActivity_Title}" 
            Description="{Binding Source={x:Static resources:Strings.Menu_Integrations_ShowGameActivity_Description}, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://agentstrap-doc.pages.dev/help/discord-rich-presence-not-working.html'}"
            IsEnabled="{Binding InnerContent.IsChecked, ElementName=ActivityTrackingOption, Mode=OneWay}"
            x:Name="DiscordActivityOption">
            <ui:ToggleSwitch IsChecked="{Binding DiscordActivityEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_Integrations_AllowActivityJoining_Title}" 
            Description="{x:Static resources:Strings.Menu_Integrations_AllowActivityJoining_Description}"
            IsEnabled="{Binding InnerContent.IsChecked, ElementName=DiscordActivityOption, Mode=OneWay}">
            <ui:ToggleSwitch IsChecked="{Binding DiscordActivityJoinEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_Integrations_ShowAccountOnProfile_Title}" 
            Description="{x:Static resources:Strings.Menu_Integrations_ShowAccountOnProfile_Description}"
            IsEnabled="{Binding InnerContent.IsChecked, ElementName=DiscordActivityOption, Mode=OneWay}">
            <ui:ToggleSwitch IsChecked="{Binding DiscordAccountOnProfile, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Style="{StaticResource AgSectionHeader}" Text="{x:Static resources:Strings.Menu_Integrations_Custom_Title}" />
        <TextBlock Style="{StaticResource AgBody}" Text="{x:Static resources:Strings.Menu_Integrations_Custom_Description}" />
        <Grid Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="CustomIntegrationsListBox" Grid.Row="0" Grid.Column="0" Margin="0,0,4,0" ItemsSource="{Binding CustomIntegrations, Mode=OneWay}" DisplayMemberPath="Name" SelectionChanged="CustomIntegrationSelection" SelectedIndex="{Binding SelectedCustomIntegrationIndex, Mode=TwoWay}" />
            <Grid Grid.Row="1" Grid.Column="0" Margin="0,8,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Appearance="Secondary" Grid.Column="0" Margin="0,0,4,0" Style="{StaticResource AgActionButton}" Icon="Add28" Content="{x:Static resources:Strings.Common_New}" Command="{Binding AddIntegrationCommand, Mode=OneTime}" />
                <ui:Button Grid.Column="1" Margin="4,0,0,0" Style="{StaticResource AgActionButton}" Icon="Delete28" Content="{x:Static resources:Strings.Common_Delete}" Appearance="Danger" IsEnabled="{Binding IsCustomIntegrationSelected, Mode=OneWay}" Command="{Binding DeleteIntegrationCommand, Mode=OneTime}" />
            </Grid>
            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="4,0,0,0">
                <StackPanel.Style>
                    <Style>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCustomIntegrationSelected}" Value="False">
                                <Setter Property="StackPanel.Visibility" Value="Hidden"></Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{x:Static resources:Strings.Common_Name}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBox Margin="0,4,0,0" Text="{Binding SelectedCustomIntegration.Name, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,8,0,0" Text="{x:Static resources:Strings.Menu_Integrations_Custom_AppLocation}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" Margin="0,0,0,0" PlaceholderText="C:\Windows\System32\cmd.exe" Text="{Binding SelectedCustomIntegration.Location}" />
                    <ui:Button Appearance="Secondary" Grid.Column="1" Margin="8,0,0,0" Height="34" Icon="Folder24" Content="{x:Static resources:Strings.Common_Browse}" Command="{Binding BrowseIntegrationLocationCommand}" />
                </Grid>
                <TextBlock Margin="0,8,0,0" Text="{x:Static resources:Strings.Menu_Integrations_Custom_LaunchArgs}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBox Margin="0,4,0,0" PlaceholderText="{Binding Source='/k echo {0}', Converter={StaticResource StringFormatConverter}, ConverterParameter={x:Static resources:Strings.Menu_Integrations_Custom_LaunchArgs_Placeholder}}" Text="{Binding SelectedCustomIntegration.LaunchArgs}" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True" />
                <CheckBox Margin="0,8,0,0" Content="{x:Static resources:Strings.Menu_Integrations_Custom_AutoClose}" IsChecked="{Binding SelectedCustomIntegration.AutoClose}" />
            </StackPanel>
            <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Text="{x:Static resources:Strings.Menu_Integrations_Custom_NoneSelected}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCustomIntegrationSelected}" Value="True">
                                <Setter Property="TextBlock.Visibility" Value="Hidden"></Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <TextBlock Style="{StaticResource AgSectionHeader}" Text="Server connection notifications" />
        <TextBlock Style="{StaticResource AgPageSubtitle}" Text="Sends a push notification through Bark whenever Agentstrap connects to a game server. The server's public IP address is sent to ipinfo.io for geolocation." />

        <controls:OptionControl Header="Send server connection notifications"
                                Description="Requires activity tracking. When enabled, Agentstrap looks up the remote game server's location and pushes a message to your phone whenever a new server is joined."
                                IsEnabled="{Binding InnerContent.IsChecked, ElementName=ActivityTrackingOption, Mode=OneWay}">
            <ui:ToggleSwitch IsChecked="{Binding ServerConnectionNotifications.Enabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Include the server's IP address in the notification"
                                Description="Adds the address of the server you connected to at the end of the message. Leave off if you do not want that information on your phone.">
            <ui:ToggleSwitch IsChecked="{Binding ServerConnectionNotifications.IncludeIpAddress, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Duplicate suppression window (minutes)"
                                Description="Connections to the same server do not trigger another notification within this interval. 0 disables suppression.">
            <ui:NumberBox Value="{Binding ServerConnectionNotifications.SuppressionMinutes, Mode=TwoWay}" Min="0" Max="1440" Step="5" IntegersOnly="True" SpinButtonsEnabled="True" Width="120" />
        </controls:OptionControl>

        <controls:OptionControl Header="Detailed diagnostic logging"
                                Description="Off by default. When enabled, full remote server IP addresses may be written to the Agentstrap log, which helps troubleshooting but keeps connection history in the log file.">
            <ui:ToggleSwitch IsChecked="{Binding ServerConnectionNotifications.Diagnostics, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Style="{StaticResource AgSectionHeader}" Text="Credentials" />
        <controls:MarkdownTextBlock Style="{StaticResource AgBody}"
            TextWrapping="Wrap"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            MarkdownText="The Bark push key and IPinfo token are stored encrypted with Windows DPAPI for the current Windows user. They are never written to Agentstrap's settings file or logged. An IPinfo token is optional, but a plan with city and region data is needed for reliable, higher quota lookups." />

        <controls:OptionControl Header="IPinfo API token"
                                Description="Stored encrypted. Leave empty to keep the currently saved token (or to run without one).">
            <controls:MarkdownTextBlock Style="{StaticResource AgBody}" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" MarkdownText="Get a token at [ipinfo.io](https://ipinfo.io/account/token)." />
        </controls:OptionControl>
        <ui:PasswordBox x:Name="IpInfoTokenBox" Width="320" HorizontalAlignment="Left" MaxLength="64"
                        PlaceholderText="Paste your IPinfo token here" />

        <controls:OptionControl Header="Bark push key"
                                Description="Copy the device key from the Bark app and store it encrypted." />
        <ui:PasswordBox x:Name="BarkPushKeyBox" Width="320" HorizontalAlignment="Left" MaxLength="256"
                        PlaceholderText="Paste your Bark push key here" />

        <TextBlock Style="{StaticResource AgSectionHeader}" Text="ipwho (backup)" />
        <controls:MarkdownTextBlock Style="{StaticResource AgBody}" TextWrapping="Wrap"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            MarkdownText="ipwho.org is used as a backup when ipinfo.io fails. You need your own API key. Get one free at [ipwho.org/free-plan](https://www.ipwho.org/free-plan), then paste it below. Without a key, the backup is disabled." />
        <controls:OptionControl Header="IPWho API key"
                                Description="Stored encrypted. Leave empty to keep the currently saved key." />
        <ui:PasswordBox x:Name="IpWhoApiKeyBox" Width="320" HorizontalAlignment="Left" MaxLength="128"
                        PlaceholderText="Paste your ipwho API key here" />

        <controls:OptionControl Header="Test IPWho connection"
                                Description="Verifies the key by looking up a fixed, well known public IP address (1.1.1.1).">
            <ui:Button Appearance="Secondary" Style="{StaticResource AgActionButton}" Icon="Globe24" Content="Test IPWho connection"
                       Click="TestIpWho_Click" />
        </controls:OptionControl>
        <TextBlock x:Name="TestIpWhoStatus" Margin="20,8,0,0" Opacity="0.85" TextWrapping="Wrap" />
        <TextBlock Margin="20,4,0,0" Opacity="0.7" TextWrapping="Wrap"
                   Text="{Binding ServerConnectionNotifications.PushKeySavedHint, Mode=OneWay}" />

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <ui:Button Appearance="Primary" Style="{StaticResource AgActionButton}" Icon="Save28" Content="Save credentials"
                       Click="SaveCredentials_Click" />
            <ui:Button Appearance="Secondary" Style="{StaticResource AgActionButton}" Icon="Delete24" Content="Clear"
                       Margin="8,0,0,0" Click="ClearCredentials_Click" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Margin="12,0,0,0" Style="{StaticResource AgBody}" Opacity="0.8"
                   Text="{Binding ServerConnectionNotifications.StatusText, Mode=OneWay}" TextWrapping="Wrap" />

        <TextBlock Style="{StaticResource AgSectionHeader}" Text="Test" />

        <controls:OptionControl Header="Test IPinfo connection"
                                Description="Verifies the token by looking up a fixed, well known public IP address (1.1.1.1). Reports whether the plan returns city and region data.">
            <ui:Button Appearance="Secondary" Style="{StaticResource AgActionButton}" Icon="Globe24" Content="Test IPinfo connection"
                       Click="TestIpInfo_Click" />
        </controls:OptionControl>
        <TextBlock x:Name="TestIpInfoStatus" Margin="20,8,0,0" Opacity="0.85" TextWrapping="Wrap" />

        <controls:OptionControl Header="Test notification"
                                Description="Sends a test message through Bark. A successful response means the API accepted the notification for delivery.">
            <ui:Button Appearance="Secondary" Style="{StaticResource AgActionButton}" Icon="Send24" Content="Test notification"
                       Click="TestNotification_Click" />
        </controls:OptionControl>
        <TextBlock x:Name="TestNotificationStatus" Margin="20,8,0,0" Opacity="0.85" TextWrapping="Wrap" />
    </StackPanel>
</ui:UiPage>
