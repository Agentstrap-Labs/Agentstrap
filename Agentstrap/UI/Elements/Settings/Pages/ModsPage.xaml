<ui:UiPage x:Class="Agentstrap.UI.Elements.Settings.Pages.ModsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:Agentstrap.UI.ViewModels"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:Agentstrap.Resources"
      xmlns:controls="clr-namespace:Agentstrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:Agentstrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:ModsViewModel, IsDesignTimeCreatable=True}"
      d:DesignHeight="800" d:DesignWidth="800"
      Title="ModsPage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">

        <TextBlock Style="{StaticResource AgPageTitle}" Text="Mods" />
        <TextBlock Style="{StaticResource AgPageSubtitle}"
                   Text="{x:Static resources:Strings.Menu_Mods_Description}" />

        <!--  Skybox.  Drag an image onto the preview or use the button; the
              converter handles cropping, so any aspect ratio works.  -->
        <TextBlock Style="{StaticResource AgSectionHeader}" Text="Game skybox" />

        <Border Style="{StaticResource AgCard}" Margin="0,10,0,0" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="SkyboxDropTarget"
                        Grid.Column="0"
                        Width="184" Height="184"
                        CornerRadius="4"
                        ClipToBounds="True"
                        AllowDrop="True"
                        DragEnter="SkyboxDropTarget_DragEnter"
                        DragLeave="SkyboxDropTarget_DragLeave"
                        Drop="SkyboxDropTarget_Drop"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Image Source="{Binding CustomSkyboxPreview, Mode=OneWay}"
                               Stretch="UniformToFill"
                               Visibility="{Binding CustomSkyboxPreviewVisibility, Mode=OneWay}" />

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding CustomSkyboxPlaceholderVisibility, Mode=OneWay}">
                            <ui:SymbolIcon Symbol="ImageGlobe24" FontSize="34" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Margin="0,8,0,0" Width="150" TextAlignment="Center" TextWrapping="Wrap"
                                       FontSize="11" Text="{Binding CustomSkyboxDropHint, Mode=OneWay}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="18,2,0,2" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AgCardLabel}" Text="Status" />
                    <TextBlock Style="{StaticResource AgBody}" Margin="0,4,0,0"
                               Text="{Binding CustomSkyboxStatus, Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <ui:Button Appearance="Secondary" Style="{StaticResource AgActionButton}" Width="180"
                                   Icon="ImageAdd24"
                                   Content="{Binding CustomSkyboxButtonText, Mode=OneWay}"
                                   Command="{Binding ManageCustomSkyboxCommand}" />

                        <ui:Button Style="{StaticResource AgActionButton}" Width="140" Margin="8,0,0,0"
                                   Icon="Delete16"
                                   Content="Remove"
                                   Appearance="Danger"
                                   Command="{Binding RemoveCustomSkyboxCommand}"
                                   Visibility="{Binding RemoveCustomSkyboxVisibility, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource AgCardHint}"
                               Text="Any PNG, JPG, BMP, GIF or TIFF. Squared up and written into the Roblox install on next launch." />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Folder entry points.  -->
        <TextBlock Style="{StaticResource AgSectionHeader}" Text="Mods folder" />

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource AgCardGap}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:CardAction Grid.Column="0" Icon="Folder24"
                           Command="{Binding OpenModsFolderCommand}">
                <StackPanel>
                    <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_Mods_OpenModsFolder_Title}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource AgCardHint}"
                               Text="{x:Static resources:Strings.Menu_Mods_OpenModsFolder_Description}" />
                </StackPanel>
            </ui:CardAction>

            <ui:CardAction Grid.Column="2" Icon="BookQuestionMark24"
                           Command="models:GlobalViewModel.OpenWebpageCommand"
                           CommandParameter="https://bloxstraplabs.com/wiki/features/modding/">
                <StackPanel>
                    <TextBlock FontSize="14" Text="{x:Static resources:Strings.Common_Help}" />
                    <TextBlock Style="{StaticResource AgCardHint}"
                               Text="{x:Static resources:Strings.Menu_Mods_Help_Description}" />
                </StackPanel>
            </ui:CardAction>
        </Grid>

        <TextBlock Style="{StaticResource AgSectionHeader}"
                   Text="{x:Static resources:Strings.Common_Presets}" />

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Mods_Presets_MouseCursor_Title}"
            Description="{x:Static resources:Strings.Menu_Mods_Presets_MouseCursor_Description}">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding CursorTypeTask.Selections, Mode=OneTime}" Text="{Binding CursorTypeTask.NewState, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Mods_Presets_OldAvatarEditor_Title}"
            Description="{x:Static resources:Strings.Menu_Mods_Presets_OldAvatarEditor_Description}">
            <ui:ToggleSwitch IsChecked="{Binding OldAvatarBackgroundTask.NewState, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Mods_Presets_OldCharacterSounds_Title}"
            Description="{x:Static resources:Strings.Menu_Mods_Presets_OldCharacterSounds_Description}">
            <ui:ToggleSwitch IsChecked="{Binding OldCharacterSoundsTask.NewState, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Mods_Presets_EmojiType_Title}"
            Description="{x:Static resources:Strings.Menu_Mods_Presets_EmojiType_Description}">
            <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="220" ItemsSource="{Binding EmojiFontTask.Selections, Mode=OneTime}" Text="{Binding EmojiFontTask.NewState, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <TextBlock Style="{StaticResource AgSectionHeader}"
                   Text="{x:Static resources:Strings.Common_Miscellaneous}" />

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Mods_Misc_CustomFont_Title}">
            <StackPanel Orientation="Horizontal">
                <ui:Button Appearance="Secondary" Icon="DocumentAdd16" Content="{x:Static resources:Strings.Menu_Mods_Misc_CustomFont_Choose}" Command="{Binding ManageCustomFontCommand}" Visibility="{Binding ChooseCustomFontVisibility, Mode=OneWay}" />
                <ui:Button Icon="Delete16" Content="{x:Static resources:Strings.Menu_Mods_Misc_CustomFont_Remove}" Appearance="Danger" Command="{Binding ManageCustomFontCommand}" Visibility="{Binding DeleteCustomFontVisibility, Mode=OneWay}" />
            </StackPanel>
        </controls:OptionControl>

        <ui:CardAction Margin="0,12,0,0" Icon="WindowWrench24" Command="{Binding OpenCompatSettingsCommand}">
            <StackPanel>
                <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_Mods_Misc_CompatibilitySettings_Title}" TextWrapping="Wrap" />
                <controls:MarkdownTextBlock Margin="0,2,0,0" FontSize="12" MarkdownText="{Binding Source={x:Static resources:Strings.Menu_Mods_Misc_CompatibilitySettings_Description}, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://devblogs.microsoft.com/directx/demystifying-full-screen-optimizations/'}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ui:CardAction>
    </StackPanel>
</ui:UiPage>